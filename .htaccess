<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    <FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json|README\.md">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Forward all traffic to the Laravel public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
